# ============================================================================
# Copie pra .env e preencha. NUNCA coloque valores reais neste arquivo (ele vai pro git).
# Na Vercel, cadastre as mesmas variáveis em Settings > Environment Variables.
# ============================================================================

# --- Banco (PostgreSQL) ---
# No seu PC: o Postgres do docker-compose.yml (as duas URLs iguais).
# No Neon: DATABASE_URL = connection string COM "-pooler" no host (usada pelo app);
#          DIRECT_URL   = connection string SEM "-pooler" (usada pelo Prisma: migrations e seeds).
DATABASE_URL="postgresql://estetica:estetica@localhost:5432/estetica"
DIRECT_URL="postgresql://estetica:estetica@localhost:5432/estetica"

# --- Sessões (cookies assinados) ---
# Obrigatório, pelo menos 32 caracteres aleatórios. Em produção o app NÃO sobe com um fraco.
# Gere com: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET=""

# --- Fotos pelo painel (serviço, logo e capa) ---
# "true" mostra os campos de foto no painel; "false" esconde e ignora arquivos enviados.
UPLOADS_HABILITADOS="true"

# --- Neon Object Storage (compatível com S3) ---
# Onde as fotos ficam. Cada branch do Neon tem endpoint, região e credencial próprios
# (crie com: neon credentials create --scope storage:read --scope storage:write).
# Prefixo NEON_S3_ (e não AWS_) porque a Vercel reserva os nomes AWS_*.
# Sem essas variáveis, as fotos vão pra pasta ./uploads (só serve no seu PC).
NEON_S3_ENDPOINT=""
NEON_S3_REGION=""
NEON_S3_ACCESS_KEY_ID=""
NEON_S3_SECRET_ACCESS_KEY=""
NEON_S3_BUCKET="fotos"

# --- Admin da plataforma (/plataforma) ---
# Criado pelo db:seed:molinari (e pelo seed de demonstração). Senha com 8+ caracteres.
PLATAFORMA_ADMIN_NOME="Nome Exemplo"
PLATAFORMA_ADMIN_EMAIL="admin@exemplo.com"
PLATAFORMA_ADMIN_SENHA="troque-esta-senha"

# --- Dono da loja Molinari (db:seed:molinari) ---
MOLINARI_DONO_NOME="Nome Exemplo"
MOLINARI_DONO_EMAIL="dono@exemplo.com"
MOLINARI_DONO_SENHA="troque-esta-senha"

# --- Só no seu PC ---
# Senha de todos os usuários do seed de DEMONSTRAÇÃO (npx prisma db seed). 8+ caracteres.
DEMO_SENHA=""
