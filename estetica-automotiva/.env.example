# Banco SQLite (arquivo fica dentro da pasta prisma/)
DATABASE_URL="file:./prisma/lavagem.db"

# Chave pra assinar os cookies de sessão. Troque por uma string grande e aleatória (mín. 32 caracteres).
# Dica: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="troque-esta-chave-por-uma-string-grande-e-aleatoria-123456"

# Dono da loja Molinari (usado só pelo `npm run db:seed:molinari`).
# Ficam aqui, e não no script, porque o repositório é público. Troque pelos dados reais no .env.
MOLINARI_DONO_NOME="Nome Exemplo"
MOLINARI_DONO_EMAIL="dono@exemplo.com"
MOLINARI_DONO_SENHA="troque-esta-senha"
